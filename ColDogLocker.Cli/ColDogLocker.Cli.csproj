<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>ColDogLocker</AssemblyName>
    <ApplicationIcon>..\resources\cdlIcon.ico</ApplicationIcon>
    
    <!-- Product Information -->
    <Product>ColDog Locker</Product>
    <AssemblyTitle>A secure file locker application</AssemblyTitle>
    <Copyright>Copyright © 2025 ColDog Studios. All Rights Reserved.</Copyright>
    
    <!-- Version Information - EDIT VERSION HERE ONLY -->
    <Version>0.2.0-pre</Version>
    <FileVersion>$(Version.Split('-')[0]).$([System.DateTime]::UtcNow.ToString(MMdd))</FileVersion>
    <InformationalVersion>$(Version)+$([System.DateTime]::UtcNow.ToString(yyyyMMddHHmm))</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ColDogLocker.Application\ColDogLocker.Application.csproj" />
    <ProjectReference Include="..\ColDogLocker.Infrastructure\ColDogLocker.Infrastructure.csproj" />
    <ProjectReference Include="..\ColDogLocker.Gui\ColDogLocker.Gui.csproj" />
    <ProjectReference Include="..\ColDogLocker.Tui\ColDogLocker.Tui.csproj" />
  </ItemGroup>

  <!-- Auto-generate BuildInfo.cs at build time -->
  <Target Name="GenerateBuildInfo" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <BuildNumber>$([System.DateTime]::UtcNow.ToString(yyyyMMddHHmm))</BuildNumber>
      <BuildDate>$([System.DateTime]::UtcNow.ToString(yyyy-MM-dd))</BuildDate>
      <BuildTime>$([System.DateTime]::UtcNow.ToString(HH:mm:ss)) UTC</BuildTime>
      <BuildVersionFull>$(Version)+$(BuildNumber)</BuildVersionFull>
      <BuildInfoContent>
// &lt;auto-generated&gt;
// This file is automatically generated at build time.
// Do not edit manually - changes will be overwritten.
// &lt;/auto-generated&gt;

namespace ColDogLocker.Cli%3B

/// &lt;summary&gt;
/// Build information auto-generated at compile time.
/// &lt;/summary&gt;
public static class BuildInfo
{
    /// &lt;summary&gt;Semantic version (e.g., "0.1.0-pre")&lt;/summary&gt;
    public const string Version = "$(Version)"%3B
    
    /// &lt;summary&gt;Build number based on UTC date/time (e.g., "202512301445")&lt;/summary&gt;
    public const string BuildNumber = "$(BuildNumber)"%3B
    
    /// &lt;summary&gt;Full version with build metadata (e.g., "0.1.0-pre+202512301445")&lt;/summary&gt;
    public const string BuildVersion = "$(BuildVersionFull)"%3B
    
    /// &lt;summary&gt;Build date in ISO format (e.g., "2025-12-30")&lt;/summary&gt;
    public const string BuildDate = "$(BuildDate)"%3B
    
    /// &lt;summary&gt;Build time in UTC (e.g., "14:45:32 UTC")&lt;/summary&gt;
    public const string BuildTime = "$(BuildTime)"%3B
}
      </BuildInfoContent>
    </PropertyGroup>
    <WriteLinesToFile
      File="$(IntermediateOutputPath)BuildInfo.g.cs"
      Lines="$(BuildInfoContent)"
      Overwrite="true"
      Encoding="UTF-8" />
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)BuildInfo.g.cs" />
      <FileWrites Include="$(IntermediateOutputPath)BuildInfo.g.cs" />
    </ItemGroup>
  </Target>

</Project>
