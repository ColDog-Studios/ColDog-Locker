<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package
    Name="ColDog Locker"
    Manufacturer="ColDog Studios"
    Version="$(var.MsiVersion)"
    UpgradeCode="0A9C2F23-FC22-4E45-96F2-A9D59F16246C"
    Scope="perMachine"
    InstallerVersion="500"
    Compressed="yes">

    <SummaryInformation Description="ColDog Locker $(var.FullVersion) $(var.PackageArchitecture)" />
    <MajorUpgrade AllowSameVersionUpgrades="yes" DowngradeErrorMessage="A newer version of ColDog Locker is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Property Id="ARPCONTACT" Value="support@coldogstudios.com" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/ColDog-Studios/ColDog-Locker" />
    <Property Id="REMOVE_USER_DATA_ON_UNINSTALL" Value="1" />
    <WixVariable Id="WixUILicenseRtf" Value="$(var.LicenseRtf)" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="CompanyFolder" Name="ColDogStudios">
        <Directory Id="INSTALLFOLDER" Name="ColDogLocker">
          <Component Id="CliExecutableComponent" Guid="*" Bitness="always64">
            <File Id="CliExecutable" Source="$(var.PublishRoot)cdlocker.exe" KeyPath="yes" />
          </Component>
          <Component Id="GuiExecutableComponent" Guid="*" Bitness="always64">
            <File Id="GuiExecutable" Source="$(var.PublishRoot)ColDogLocker.exe" KeyPath="yes" />
          </Component>
          <Component Id="ReadmeComponent" Guid="*" Bitness="always64">
            <File Source="$(var.PublishRoot)README.md" KeyPath="yes" />
          </Component>
          <Component Id="LicenseComponent" Guid="*" Bitness="always64">
            <File Source="$(var.PublishRoot)LICENSE" KeyPath="yes" />
          </Component>
          <Component Id="IconComponent" Guid="*" Bitness="always64">
            <File Source="$(var.PublishRoot)cdlIcon.ico" KeyPath="yes" />
          </Component>
          <Component Id="MachinePathComponent" Guid="*" Bitness="always64">
            <RegistryValue Root="HKLM" Key="Software\ColDog Studios\ColDog Locker" Name="InstallDir" Value="[INSTALLFOLDER]" Type="string" KeyPath="yes" />
            <Environment Id="AddCdlockerToPath" Name="PATH" Value="[INSTALLFOLDER]" Permanent="no" Part="last" Action="set" System="yes" />
          </Component>
        </Directory>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="ColDogLocker">
        <Component Id="StartMenuShortcutComponent" Guid="*" Bitness="always64">
          <Shortcut Id="StartMenuShortcut" Name="ColDog Locker" Target="[#GuiExecutable]" WorkingDirectory="INSTALLFOLDER" />
          <RemoveFolder Id="RemoveApplicationProgramsFolder" On="uninstall" />
          <RegistryValue Root="HKCU" Key="Software\ColDog Studios\ColDog Locker" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder">
      <Component Id="DesktopShortcutComponent" Guid="*" Bitness="always64">
        <Shortcut Id="DesktopShortcut" Name="ColDog Locker" Target="[#GuiExecutable]" WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKCU" Key="Software\ColDog Studios\ColDog Locker" Name="DesktopShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <Component Id="RemoveUserDataOptionComponent" Directory="INSTALLFOLDER" Guid="*" Bitness="always64">
      <RegistryValue Root="HKCU" Key="Software\ColDog Studios\ColDog Locker" Name="RemoveUserDataOnUninstall" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <CustomAction Id="RemoveUserData"
                  Directory="SystemFolder"
                  Execute="deferred"
                  Impersonate="yes"
                  Return="ignore"
                  ExeCommand='cmd.exe /c rmdir /s /q "%LOCALAPPDATA%\ColDog Studios\ColDog Locker" &amp; rmdir /s /q "%USERPROFILE%\Documents\ColDog Locker"' />

    <InstallExecuteSequence>
      <Custom Action="RemoveUserData" Before="RemoveFiles" Condition='REMOVE="ALL" AND !RemoveUserDataFeature=3 AND REMOVE_USER_DATA_ON_UNINSTALL="1"' />
    </InstallExecuteSequence>

    <!-- The MSI is a combined app installer: CLI and Avalonia GUI ship together. -->
    <Feature Id="MainFeature" Title="ColDog Locker" Level="1" AllowAbsent="no">
      <ComponentRef Id="CliExecutableComponent" />
      <ComponentRef Id="GuiExecutableComponent" />
      <ComponentRef Id="ReadmeComponent" />
      <ComponentRef Id="LicenseComponent" />
      <ComponentRef Id="IconComponent" />
      <ComponentRef Id="MachinePathComponent" />
      <ComponentRef Id="StartMenuShortcutComponent" />
    </Feature>

    <Feature Id="DesktopShortcutFeature" Title="Desktop shortcut" Description="Create a shortcut on the installing user's desktop." Level="2">
      <ComponentRef Id="DesktopShortcutComponent" />
    </Feature>

    <Feature Id="RemoveUserDataFeature" Title="Remove stored config and data on uninstall" Description="Remove settings, logs, locker metadata, and the default locker folder when uninstalling." Level="1">
      <ComponentRef Id="RemoveUserDataOptionComponent" />
    </Feature>

    <ui:WixUI Id="WixUI_FeatureTree" />
  </Package>
</Wix>
