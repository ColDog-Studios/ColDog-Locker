<Window x:Class="ColDogStudios.ColDogLocker.Gui.WPF.Dialogs.LockerPropertiesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Locker Properties"
        Width="500"
        Height="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BackgroundBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Content -->
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- General Information -->
                <TextBlock Text="General"
                           FontWeight="SemiBold"
                           FontSize="16"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Margin="0,0,0,16" />

                <!-- Locker Name -->
                <StackPanel Margin="0,0,0,16">
                    <TextBlock Text="Name"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Margin="0,0,0,8" />
                    <TextBox x:Name="NameTextBox"
                             TextChanged="NameTextBox_TextChanged" />
                </StackPanel>

                <!-- Location -->
                <StackPanel Margin="0,0,0,16">
                    <TextBlock Text="Location"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Margin="0,0,0,8" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="LocationTextBox"
                                 Grid.Column="0"
                                 IsReadOnly="True"
                                 Margin="0,0,8,0" />
                        <Button Content="Browse..."
                                Grid.Column="1"
                                Click="BrowseButton_Click"
                                Padding="15,5"
                                IsEnabled="False"
                                ToolTip="Location cannot be changed while locker is locked" />
                    </Grid>
                    <TextBlock Text="Location cannot be changed while locker is locked"
                               x:Name="LocationWarningText"
                               Foreground="{DynamicResource WarningBrush}"
                               FontSize="12"
                               Margin="0,4,0,0"
                               Visibility="Collapsed" />
                </StackPanel>

                <!-- Status -->
                <StackPanel Margin="0,0,0,16">
                    <TextBlock Text="Status"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="StatusIcon"
                                   Text="&#xE72E;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="16"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0" />
                        <TextBlock x:Name="StatusText"
                                   Text="Locked"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>

                <!-- Size -->
                <StackPanel Margin="0,0,0,16">
                    <TextBlock Text="Size"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Margin="0,0,0,8" />
                    <TextBlock x:Name="SizeText"
                               Text="0 bytes"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>

                <!-- Dates -->
                <TextBlock Text="Dates"
                           FontWeight="SemiBold"
                           FontSize="16"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Margin="0,8,0,16" />

                <!-- Created -->
                <StackPanel Margin="0,0,0,16">
                    <TextBlock Text="Created"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Margin="0,0,0,8" />
                    <TextBlock x:Name="CreatedText"
                               Text="N/A"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>

                <!-- Modified -->
                <StackPanel Margin="0,0,0,16">
                    <TextBlock Text="Last Modified"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Margin="0,0,0,8" />
                    <TextBlock x:Name="ModifiedText"
                               Text="N/A"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Buttons -->
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="Save"
                    x:Name="SaveButton"
                    Click="SaveButton_Click"
                    IsEnabled="False"
                    Padding="20,8"
                    Margin="0,0,8,0" />
            <Button Content="Close"
                    Click="CloseButton_Click"
                    Padding="20,8" />
        </StackPanel>
    </Grid>
</Window>
