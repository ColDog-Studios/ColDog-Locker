<Window x:Class="ColDogStudios.ColDogLocker.Gui.WPF.Dialogs.DevDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Developer Information" 
        Width="600" 
        Height="700"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{DynamicResource BackgroundBrush}"
        Loaded="Window_Loaded">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Scrollable Content Section -->
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="20">
            <StackPanel>
                
                <!-- Build Information Section -->
                <Border Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="5"
                        Padding="15"
                        Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="Build Information" 
                                  FontSize="14"
                                  FontWeight="Bold"
                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                  Margin="0,0,0,10"/>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <!-- Version -->
                            <TextBlock Grid.Column="0" Grid.Row="0" Text="Version:" FontWeight="SemiBold" 
                                      Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,10,8"/>
                            <TextBlock x:Name="VersionText" Grid.Column="1" Grid.Row="0" Text="0.3.0-alpha" 
                                      Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                            
                            <!-- Build Number -->
                            <TextBlock Grid.Column="0" Grid.Row="1" Text="Build Number:" FontWeight="SemiBold" 
                                      Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,10,8"/>
                            <TextBlock x:Name="BuildNumberText" Grid.Column="1" Grid.Row="1" Text="202605201941" 
                                      Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                            
                            <!-- Build Date -->
                            <TextBlock Grid.Column="0" Grid.Row="2" Text="Build Date:" FontWeight="SemiBold" 
                                      Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,10,8"/>
                            <TextBlock x:Name="BuildDateText" Grid.Column="1" Grid.Row="2" Text="2026-05-20" 
                                      Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                            
                            <!-- Build Time -->
                            <TextBlock Grid.Column="0" Grid.Row="3" Text="Build Time:" FontWeight="SemiBold" 
                                      Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,10,8"/>
                            <TextBlock x:Name="BuildTimeText" Grid.Column="1" Grid.Row="3" Text="19:41:47 UTC" 
                                      Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                            
                            <!-- Full Version -->
                            <TextBlock Grid.Column="0" Grid.Row="4" Text="Full Version:" FontWeight="SemiBold" 
                                      Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,10,8"/>
                            <TextBlock x:Name="FullVersionText" Grid.Column="1" Grid.Row="4" Text="0.3.0-alpha+202605201941" 
                                      Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- System Information Section -->
                <Border Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="5"
                        Padding="15"
                        Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="System Information" 
                                  FontSize="14"
                                  FontWeight="Bold"
                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                  Margin="0,0,0,10"/>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <!-- OS -->
                            <TextBlock Grid.Column="0" Grid.Row="0" Text="OS:" FontWeight="SemiBold" 
                                      Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,10,8"/>
                            <TextBlock x:Name="OSText" Grid.Column="1" Grid.Row="0" Text="Windows 10" 
                                      Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                            
                            <!-- .NET Version -->
                            <TextBlock Grid.Column="0" Grid.Row="1" Text=".NET Version:" FontWeight="SemiBold" 
                                      Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,10,8"/>
                            <TextBlock x:Name="RuntimeText" Grid.Column="1" Grid.Row="1" Text=".NET 10.0" 
                                      Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                            
                            <!-- Processors -->
                            <TextBlock Grid.Column="0" Grid.Row="2" Text="CPU Cores:" FontWeight="SemiBold" 
                                      Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,10,8"/>
                            <TextBlock x:Name="ProcessorCountText" Grid.Column="1" Grid.Row="2" Text="4" 
                                      Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                            
                            <!-- Available Memory -->
                            <TextBlock Grid.Column="0" Grid.Row="3" Text="RAM (Total):" FontWeight="SemiBold" 
                                      Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,10,8"/>
                            <TextBlock x:Name="TotalMemoryText" Grid.Column="1" Grid.Row="3" Text="8 GB" 
                                      Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                            
                            <!-- Available Memory -->
                            <TextBlock Grid.Column="0" Grid.Row="4" Text="RAM (Available):" FontWeight="SemiBold" 
                                      Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,10,8"/>
                            <TextBlock x:Name="AvailableMemoryText" Grid.Column="1" Grid.Row="4" Text="4 GB" 
                                      Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                            
                            <!-- Architecture -->
                            <TextBlock Grid.Column="0" Grid.Row="5" Text="Architecture:" FontWeight="SemiBold" 
                                      Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,10,8"/>
                            <TextBlock x:Name="ArchitectureText" Grid.Column="1" Grid.Row="5" Text="x64" 
                                      Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                            
                            <!-- Install Path -->
                            <TextBlock Grid.Column="0" Grid.Row="6" Text="Install Path:" FontWeight="SemiBold" 
                                      Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,10,8"/>
                            <TextBlock x:Name="InstallPathText" Grid.Column="1" Grid.Row="6" Text="C:\Program Files\ColDog Locker" 
                                      Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Application Paths Section -->
                <Border Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="5"
                        Padding="15"
                        Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="Application Paths" 
                                  FontSize="14"
                                  FontWeight="Bold"
                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                  Margin="0,0,0,10"/>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <!-- Config Directory -->
                            <TextBlock Grid.Column="0" Grid.Row="0" Text="Config Directory:" FontWeight="SemiBold" 
                                      Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,10,8"/>
                            <TextBlock x:Name="ConfigDirText" Grid.Column="1" Grid.Row="0" Text="%LOCALAPPDATA%\ColDog Locker" 
                                      Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                            
                            <!-- Database Path -->
                            <TextBlock Grid.Column="0" Grid.Row="1" Text="Database Path:" FontWeight="SemiBold" 
                                      Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,10,8"/>
                            <TextBlock x:Name="DatabasePathText" Grid.Column="1" Grid.Row="1" Text="%LOCALAPPDATA%\ColDog Locker\database.db" 
                                      Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Button Area -->
        <Border Grid.Row="1" 
                BorderBrush="{DynamicResource BorderBrush}" 
                BorderThickness="0,1,0,0"
                Padding="20">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Copy to Clipboard" 
                        Click="CopyToClipboard_Click"
                        Padding="15,10"
                        Background="{DynamicResource AccentBrush}"
                        Foreground="{DynamicResource AccentTextBrush}"
                        FontSize="12"
                        Cursor="Hand"
                        Margin="0,0,10,0"/>
                <Button Content="Close" 
                        Click="Close_Click"
                        Padding="15,10"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        FontSize="12"
                        Cursor="Hand"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
