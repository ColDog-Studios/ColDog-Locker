<Window x:Class="ColDogStudios.ColDogLocker.Gui.WPF.Dialogs.ProgressDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Operation in Progress" 
        Width="450" 
        Height="350"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BackgroundBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Content -->
        <StackPanel Grid.Row="0">
            <!-- Operation Title -->
            <TextBlock x:Name="OperationText" 
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       Margin="0,0,0,16"/>

            <!-- Current Item -->
            <TextBlock x:Name="CurrentItemText" 
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="0,0,0,16"/>

            <!-- Progress Bar -->
            <ProgressBar x:Name="OperationProgressBar" 
                         Minimum="0"
                         Maximum="100"
                         Value="0"
                         Height="20"
                         Margin="0,0,0,8"/>

            <!-- Progress Text -->
            <TextBlock x:Name="ProgressText" 
                       HorizontalAlignment="Center"
                       FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="0,0,0,16"/>

            <!-- Status Messages -->
            <ScrollViewer x:Name="StatusScrollViewer"
                          MaxHeight="150" 
                          VerticalScrollBarVisibility="Auto"
                          Visibility="Collapsed"
                          Margin="0,0,0,16">
                <TextBlock x:Name="StatusText" 
                           TextWrapping="Wrap"
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
            </ScrollViewer>
        </StackPanel>

        <!-- Buttons -->
        <StackPanel Grid.Row="1" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0">
            <Button x:Name="CancelButton"
                    Content="Cancel" 
                    Click="CancelButton_Click"
                    Padding="20,5"/>
        </StackPanel>
    </Grid>
</Window>
