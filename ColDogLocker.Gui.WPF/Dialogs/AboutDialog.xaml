<Window x:Class="ColDogStudios.ColDogLocker.Gui.WPF.Dialogs.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="About ColDog Locker"
        Width="500"
        Height="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BackgroundBrush}"
        Loaded="Window_Loaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Scrollable Content Section -->
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- Header Section -->
                <Border Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="30">
                    <StackPanel HorizontalAlignment="Center">
                        <!-- App Icon -->
                        <Image Source="../cdlIcon.ico"
                               Width="128"
                               Height="128"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,0"
                               RenderOptions.BitmapScalingMode="HighQuality" />

                        <TextBlock Text="ColDog Locker"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   HorizontalAlignment="Center" />

                        <TextBlock x:Name="VersionText"
                                   Text="Version 1.0.0"
                                   FontSize="14"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,5,0,0" />
                    </StackPanel>
                </Border>

                <!-- Content -->
                <StackPanel Margin="30,20">

                    <!-- Description -->
                    <TextBlock Text="Secure File Encryption Solution"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,10" />

                    <TextBlock Text="A powerful and user-friendly application for encrypting and managing your sensitive files with military-grade security."
                               FontSize="13"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Margin="0,0,0,25" />

                    <!-- Copyright -->
                    <Border Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="15"
                            Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock Text="Copyright © 2026 ColDog Studios"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="Licensed under the GNU General Public License v3.0"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Links Section -->
                    <TextBlock Text="Resources"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Margin="0,10,0,10" />

                    <StackPanel>
                        <Button Content="📖 Documentation"
                                Click="Documentation_Click"
                                HorizontalAlignment="Stretch"
                                Padding="12,8"
                                Margin="0,0,0,8"
                                HorizontalContentAlignment="Left"
                                Background="{DynamicResource CardBackgroundBrush}"
                                Foreground="{DynamicResource TextPrimaryBrush}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Content="🐙 GitHub Repository"
                                Click="GitHub_Click"
                                HorizontalAlignment="Stretch"
                                Padding="12,8"
                                Margin="0,0,0,8"
                                HorizontalContentAlignment="Left"
                                Background="{DynamicResource CardBackgroundBrush}"
                                Foreground="{DynamicResource TextPrimaryBrush}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Content="🐛 Report an Issue"
                                Click="ReportIssue_Click"
                                HorizontalAlignment="Stretch"
                                Padding="12,8"
                                Margin="0,0,0,8"
                                HorizontalContentAlignment="Left"
                                Background="{DynamicResource CardBackgroundBrush}"
                                Foreground="{DynamicResource TextPrimaryBrush}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Content="📧 Contact Support"
                                Click="ContactSupport_Click"
                                HorizontalAlignment="Stretch"
                                Padding="12,8"
                                HorizontalContentAlignment="Left"
                                Background="{DynamicResource CardBackgroundBrush}"
                                Foreground="{DynamicResource TextPrimaryBrush}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>

                    <!-- Third-Party Libraries -->
                    <TextBlock Text="Third-Party Libraries"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Margin="0,20,0,10" />

                    <Border Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="15">
                        <StackPanel>
                            <TextBlock Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="12"
                                       TextWrapping="Wrap">
                                <Run Text="• CommunityToolkit.Mvvm" FontWeight="SemiBold" />
                                <Run Text=" - MIT License" />
                                <LineBreak />
                                <Run Text="  MVVM helpers and source generators" />
                                <LineBreak /><LineBreak />

                                <Run Text="• Microsoft.Data.Sqlite" FontWeight="SemiBold" />
                                <Run Text=" - MIT License" />
                                <LineBreak />
                                <Run Text="  Lightweight database engine" />
                                <LineBreak /><LineBreak />

                                <Run Text="• BCrypt.Net-Next" FontWeight="SemiBold" />
                                <Run Text=" - MIT License" />
                                <LineBreak />
                                <Run Text="  Password hashing and verification" />
                                <LineBreak /><LineBreak />

                                <Run Text="• Newtonsoft.Json" FontWeight="SemiBold" />
                                <Run Text=" - MIT License" />
                                <LineBreak />
                                <Run Text="  JSON serialization and deserialization" />
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- System Info -->
                    <TextBlock Text="System Information"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Margin="0,20,0,10" />

                    <Border Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="15">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0"
                                           Text="Operating System:"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           FontSize="12"
                                           Margin="0,0,10,5" />
                                <TextBlock Grid.Row="0" Grid.Column="1"
                                           x:Name="OSText"
                                           Text="Windows 11"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="12"
                                           Margin="0,0,0,5" />

                                <TextBlock Grid.Row="1" Grid.Column="0"
                                           Text=".NET Runtime:"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           FontSize="12"
                                           Margin="0,0,10,5" />
                                <TextBlock Grid.Row="1" Grid.Column="1"
                                           x:Name="RuntimeText"
                                           Text=".NET 10.0"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="12"
                                           Margin="0,0,0,5" />

                                <TextBlock Grid.Row="2" Grid.Column="0"
                                           Text="Installation Path:"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           FontSize="12"
                                           Margin="0,0,10,0" />
                                <TextBlock Grid.Row="2" Grid.Column="1"
                                           x:Name="InstallPathText"
                                           Text="C:\Program Files\ColDog Locker"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="12"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Bottom Buttons -->
        <Border Grid.Row="1"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="20">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Check for Updates"
                        Click="CheckForUpdates_Click"
                        Padding="15,8"
                        Margin="0,0,8,0"
                        Background="{DynamicResource PrimaryBrush}"
                        Foreground="White">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                        </Style>
                    </Button.Style>
                </Button>

                <Button Content="Close"
                        Click="Close_Click"
                        IsDefault="True"
                        Padding="25,8"
                        Background="{DynamicResource PrimaryBrush}"
                        Foreground="White" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
