<Window x:Class="ColDogStudios.ColDogLocker.Gui.WPF.Dialogs.NewLockerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Create New Locker" 
        Width="600" 
        Height="700"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BackgroundBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Content -->
        <StackPanel Grid.Row="0">
            <!-- Locker Name -->
            <StackPanel Margin="0,0,0,16">
                <TextBlock Text="Locker Name" 
                          FontWeight="SemiBold" 
                          Foreground="{DynamicResource TextPrimaryBrush}"
                          Margin="0,0,0,8"/>
                <Grid>
                    <TextBox x:Name="LockerNameTextBox" 
                             Height="40"
                             TextChanged="LockerNameTextBox_TextChanged"/>
                    <TextBlock Text="Enter locker name"
                               IsHitTestVisible="False"
                               Foreground="Gray"
                               Margin="16,0,16,0"
                               VerticalAlignment="Center"
                               FontSize="14">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=LockerNameTextBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                <TextBlock x:Name="NameErrorText" 
                          Text="Locker name is required" 
                          Foreground="{DynamicResource ErrorBrush}"
                          Visibility="Collapsed"
                          FontSize="12"
                          Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Location -->
            <StackPanel Margin="0,0,0,16">
                <TextBlock Text="Location" 
                          FontWeight="SemiBold" 
                          Foreground="{DynamicResource TextPrimaryBrush}"
                          Margin="0,0,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0" Margin="0,0,8,0">
                        <TextBox x:Name="LocationTextBox" 
                                 Height="40"
                                 IsReadOnly="True"
                                 ToolTip="{Binding Text, ElementName=LocationTextBox}"/>
                        <TextBlock Text="Select folder to lock"
                                   IsHitTestVisible="False"
                                   Foreground="Gray"
                                   Margin="16,0,16,0"
                                   VerticalAlignment="Center"
                                   FontSize="14">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=LocationTextBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <Button Grid.Column="1" 
                            Content="Browse..." 
                            Click="BrowseButton_Click"
                            Height="40"
                            Padding="15,0"/>
                </Grid>
                <TextBlock x:Name="LocationErrorText" 
                          Text="Please select a folder" 
                          Foreground="{DynamicResource ErrorBrush}"
                          Visibility="Collapsed"
                          FontSize="12"
                          Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Password -->
            <StackPanel Margin="0,0,0,16">
                <TextBlock Text="Password" 
                          FontWeight="SemiBold" 
                          Foreground="{DynamicResource TextPrimaryBrush}"
                          Margin="0,0,0,8"/>
                <PasswordBox x:Name="PasswordBox"
                            Height="40"
                            PasswordChanged="PasswordBox_PasswordChanged"/>
                
                <!-- Dynamic Password Requirements -->
                <StackPanel x:Name="PasswordRequirementsPanel" 
                           Margin="0,8,0,0">
                    <!-- Requirements will be dynamically added here -->
                </StackPanel>
                
                <TextBlock x:Name="PasswordErrorText" 
                          Text="Password validation error" 
                          Foreground="{DynamicResource ErrorBrush}"
                          Visibility="Collapsed"
                          FontSize="12"
                          Margin="0,4,0,0"
                          TextWrapping="Wrap"/>
            </StackPanel>

            <!-- Confirm Password -->
            <StackPanel Margin="0,0,0,16">
                <TextBlock Text="Confirm Password" 
                          FontWeight="SemiBold" 
                          Foreground="{DynamicResource TextPrimaryBrush}"
                          Margin="0,0,0,8"/>
                <PasswordBox x:Name="ConfirmPasswordBox"
                            Height="40"
                            PasswordChanged="ConfirmPasswordBox_PasswordChanged"/>
                <TextBlock x:Name="ConfirmPasswordErrorText" 
                          Text="Passwords do not match" 
                          Foreground="{DynamicResource ErrorBrush}"
                          Visibility="Collapsed"
                          FontSize="12"
                          Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Options -->
            <StackPanel Margin="0,0,0,16">
                <TextBlock Text="Options" 
                          FontWeight="SemiBold" 
                          Foreground="{DynamicResource TextPrimaryBrush}"
                          Margin="0,0,0,8"/>
                <CheckBox x:Name="LockImmediatelyCheckBox" 
                          Content="Lock immediately after creation"
                          IsChecked="False"
                          Foreground="{DynamicResource TextPrimaryBrush}"/>
            </StackPanel>
        </StackPanel>

        <!-- Buttons -->
        <StackPanel Grid.Row="1" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0">
            <Button x:Name="CreateButton"
                    Content="Create" 
                    Click="CreateButton_Click" 
                    IsDefault="True"
                    Padding="20,5"
                    Margin="0,0,8,0"
                    Background="{DynamicResource PrimaryBrush}"
                    Foreground="White"/>
            <Button Content="Cancel" 
                    Click="CancelButton_Click" 
                    IsCancel="True"
                    Padding="20,5"/>
        </StackPanel>
    </Grid>
</Window>
