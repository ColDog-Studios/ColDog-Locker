<Window x:Class="ColDogStudios.ColDogLocker.Gui.WPF.Dialogs.PasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Enter Password"
        Width="400"
        Height="250"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BackgroundBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Content -->
        <StackPanel Grid.Row="0">
            <!-- Locker Name Display -->
            <TextBlock x:Name="LockerNameText"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       Margin="0,0,0,16" />

            <!-- Password Input -->
            <StackPanel Margin="0,0,0,16">
                <TextBlock Text="Password"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Margin="0,0,0,8" />
                <PasswordBox x:Name="PasswordBox"
                             PasswordChanged="PasswordBox_PasswordChanged"
                             KeyDown="PasswordBox_KeyDown" />
                <TextBlock x:Name="ErrorText"
                           Foreground="{DynamicResource ErrorBrush}"
                           Visibility="Collapsed"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Margin="0,4,0,0" />
            </StackPanel>

            <!-- Remember Option (for future enhancement) -->
            <CheckBox x:Name="RememberCheckBox"
                      Content="Remember for this session"
                      Visibility="Collapsed"
                      Foreground="{DynamicResource TextPrimaryBrush}" />
        </StackPanel>

        <!-- Buttons -->
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0">
            <Button x:Name="OkButton"
                    Content="OK"
                    Click="OkButton_Click"
                    IsDefault="True"
                    Padding="20,5"
                    Margin="0,0,8,0"
                    Background="{DynamicResource PrimaryBrush}"
                    Foreground="White" />
            <Button Content="Cancel"
                    Click="CancelButton_Click"
                    IsCancel="True"
                    Padding="20,5" />
        </StackPanel>
    </Grid>
</Window>
