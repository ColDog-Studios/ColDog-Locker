<Window x:Class="ColDogStudios.ColDogLocker.Gui.WPF.Dialogs.ErrorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Error"
        Width="600"
        Height="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BackgroundBrush}"
        Loaded="Window_Loaded">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Error Icon and Title -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
            <TextBlock Text="&#xE783;"
                       FontFamily="Segoe MDL2 Assets"
                       FontSize="48"
                       Foreground="{DynamicResource ErrorBrush}"
                       VerticalAlignment="Center"
                       Margin="0,0,15,0" />
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="ErrorTitleText"
                           Text="An Error Occurred"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           TextWrapping="Wrap" />
                <TextBlock x:Name="ErrorMessageText"
                           Text="Error message will appear here"
                           FontSize="14"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           Margin="0,5,0,0"
                           MaxWidth="480"
                           HorizontalAlignment="Left" />
            </StackPanel>
        </StackPanel>

        <!-- Technical Details Section -->
        <Expander Grid.Row="1"
                  Header="Technical Details"
                  IsExpanded="False"
                  Margin="0,0,0,15"
                  Foreground="{DynamicResource TextPrimaryBrush}">
            <Border Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="10"
                    Margin="0,10,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="150">
                    <StackPanel>
                        <TextBlock Text="Exception Type:"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Margin="0,0,0,4" />
                        <TextBlock x:Name="ExceptionTypeText"
                                   Text="System.Exception"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontFamily="Consolas"
                                   FontSize="12"
                                   Margin="0,0,0,10" />

                        <TextBlock Text="Stack Trace:"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Margin="0,0,0,4" />
                        <TextBlock x:Name="StackTraceText"
                                   Text="Stack trace will appear here"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontFamily="Consolas"
                                   FontSize="11"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Expander>

        <!-- Full Error Details (Hidden TextBox for copying) -->
        <Border Grid.Row="2"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="10"
                Margin="0,0,0,20">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBox x:Name="FullErrorTextBox"
                         Text="Full error details for copying..."
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         BorderThickness="0"
                         Background="Transparent"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         FontFamily="Consolas"
                         FontSize="11" />
            </ScrollViewer>
        </Border>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="Copy Error"
                    Click="CopyError_Click"
                    Padding="15,8"
                    Margin="0,0,8,0"
                    Background="{DynamicResource CardBackgroundBrush}"
                    Foreground="{DynamicResource TextPrimaryBrush}"
                    ToolTip="Copy error details to clipboard">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                        <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                    </Style>
                </Button.Style>
            </Button>

            <Button Content="Open Logs Folder"
                    Click="OpenLogs_Click"
                    Padding="15,8"
                    Margin="0,0,8,0"
                    Background="{DynamicResource CardBackgroundBrush}"
                    Foreground="{DynamicResource TextPrimaryBrush}"
                    ToolTip="Open the logs folder in File Explorer">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                        <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                    </Style>
                </Button.Style>
            </Button>

            <Button Content="OK"
                    Click="OK_Click"
                    IsDefault="True"
                    Padding="25,8"
                    Background="{DynamicResource PrimaryBrush}"
                    Foreground="White" />
        </StackPanel>
    </Grid>
</Window>
