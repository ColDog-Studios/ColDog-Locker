<Window x:Class="ColDogStudios.ColDogLocker.Gui.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="ColDog Locker" Height="600" Width="1000"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanMinimize"
        Loaded="Window_Loaded">
    
    <Border CornerRadius="10" 
            BorderBrush="#80000000" 
            BorderThickness="1">
        <Border CornerRadius="10"
                Background="{DynamicResource AppBackgroundGradientBrush}"
                ClipToBounds="True">
            <Border.Clip>
                <RectangleGeometry RadiusX="10" RadiusY="10" Rect="0,0,998,598"/>
            </Border.Clip>
        <DockPanel>
            <!-- Custom Title Bar -->
            <Grid DockPanel.Dock="Top" 
                  Background="{DynamicResource HeaderGradientBrush}"
                  Height="40"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- App Icon and Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="15,0,0,0" VerticalAlignment="Center">
                    <Image Source="cdlIcon.ico"
                           Width="32" 
                           Height="32"
                           Margin="0,0,10,0"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="ColDog Locker" 
                               FontWeight="SemiBold"
                               FontSize="18"
                               Foreground="{DynamicResource HeaderTextBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>
                
                <!-- Window Controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="MinimizeButton" 
                            Content="─" 
                            Width="40" Height="40"
                            Click="Minimize_Click"
                            Style="{DynamicResource WindowControlButtonStyle}"
                            Foreground="{DynamicResource HeaderTextBrush}"
                            ToolTip="Minimize"/>
                    <Button x:Name="CloseButton" 
                            Content="✕" 
                            Width="40" Height="40"
                            Click="Close_Click"
                            Style="{DynamicResource CloseButtonStyle}"
                            Foreground="{DynamicResource HeaderTextBrush}"
                            ToolTip="Close"/>
                </StackPanel>
            </Grid>
        <!-- Menu Bar -->
        <Menu x:Name="MainMenu" DockPanel.Dock="Top">
            <!-- File Menu -->
            <MenuItem Header="_File">
                <MenuItem Header="_New Locker" Click="NewLocker_Click" InputGestureText="Ctrl+N">
                    <MenuItem.Icon>
                        <TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons" FontSize="16" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator Style="{StaticResource MenuSeparatorStyle}"/>
                <MenuItem Header="E_xit" Click="Exit_Click" InputGestureText="Alt+F4">
                    <MenuItem.Icon>
                        <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons" FontSize="16" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>

            <!-- Locker Menu -->
            <MenuItem Header="_Locker">
                <MenuItem x:Name="LockMenuItem" Header="_Lock" Click="Lock_Click">
                    <MenuItem.Icon>
                        <TextBlock Text="&#xE72E;" FontFamily="Segoe Fluent Icons" FontSize="16" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem x:Name="UnlockMenuItem" Header="_Unlock" Click="Unlock_Click">
                    <MenuItem.Icon>
                        <TextBlock Text="&#xE785;" FontFamily="Segoe Fluent Icons" FontSize="16" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator Style="{StaticResource MenuSeparatorStyle}"/>
                <MenuItem x:Name="RemoveMenuItem" Header="_Remove" Click="Remove_Click" InputGestureText="Delete">
                    <MenuItem.Icon>
                        <TextBlock Text="&#xE74D;" FontFamily="Segoe Fluent Icons" FontSize="16" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator Style="{StaticResource MenuSeparatorStyle}"/>
                <MenuItem x:Name="PropertiesMenuItem" Header="_Properties" Click="Properties_Click">
                    <MenuItem.Icon>
                        <TextBlock Text="&#xE946;" FontFamily="Segoe Fluent Icons" FontSize="16" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem x:Name="OpenLocationMenuItem" Header="Open _Location" Click="OpenLocation_Click">
                    <MenuItem.Icon>
                        <TextBlock Text="&#xED25;" FontFamily="Segoe Fluent Icons" FontSize="16" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>

            <!-- View Menu -->
            <MenuItem Header="_View">
                <MenuItem Header="_Toggle View" Click="ToggleView_Click" InputGestureText="Ctrl+T">
                    <MenuItem.Icon>
                        <TextBlock Text="&#xE8A9;" FontFamily="Segoe Fluent Icons" FontSize="16" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator Style="{StaticResource MenuSeparatorStyle}"/>
                <MenuItem Header="_Refresh" Click="Refresh_Click" InputGestureText="F5">
                    <MenuItem.Icon>
                        <TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons" FontSize="16" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>

            <!-- Tools Menu -->
            <MenuItem Header="_Tools">
                <MenuItem Header="_Settings" Click="Settings_Click">
                    <MenuItem.Icon>
                        <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons" FontSize="16" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Check for Updates" Click="CheckUpdates_Click">
                    <MenuItem.Icon>
                        <TextBlock Text="&#xE895;" FontFamily="Segoe Fluent Icons" FontSize="16" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>

            <!-- Help Menu -->
            <MenuItem Header="_Help" Click="MenuItem_Click">
                <MenuItem Header="_Documentation" Click="Documentation_Click">
                    <MenuItem.Icon>
                        <TextBlock Text="&#xE736;" FontFamily="Segoe Fluent Icons" FontSize="16" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator Style="{StaticResource MenuSeparatorStyle}"/>
                <MenuItem Header="Test _Error Dialog" Click="TestErrorDialog_Click"></MenuItem>
                <Separator Style="{StaticResource MenuSeparatorStyle}"/>
                <MenuItem Header="_About" Click="About_Click">
                    <MenuItem.Icon>
                        <TextBlock Text="&#xE946;" FontFamily="Segoe Fluent Icons" FontSize="16" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
        </Menu>

        <!-- Toolbar -->
        <Border DockPanel.Dock="Top" 
                BorderBrush="{DynamicResource BorderBrush}" 
                BorderThickness="0,0,0,1">
            <ToolBarTray IsLocked="True">
                <ToolBar x:Name="MainToolBar">
                <ToolBar.Resources>
                    <Style TargetType="{x:Type ToggleButton}" x:Key="{x:Static ToolBar.ToggleButtonStyleKey}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                    </Style>
                </ToolBar.Resources>
                
                <!-- New Locker -->
                <Button Click="NewLocker_Click" 
                        ToolTip="Create new locker (Ctrl+N)"
                        Style="{StaticResource ToolBarButtonStyle}">
                    <TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons" FontSize="20"/>
                </Button>
                
                <Separator Style="{StaticResource ToolBarSeparatorStyle}"/>

                <!-- Lock -->
                <Button x:Name="LockButton" 
                        Click="Lock_Click" 
                        ToolTip="Lock selected locker(s)"
                        Style="{StaticResource ToolBarButtonStyle}">
                    <TextBlock Text="&#xE72E;" FontFamily="Segoe Fluent Icons" FontSize="20"/>
                </Button>

                <!-- Unlock -->
                <Button x:Name="UnlockButton" 
                        Click="Unlock_Click" 
                        ToolTip="Unlock selected locker(s)"
                        Style="{StaticResource ToolBarButtonStyle}">
                    <TextBlock Text="&#xE785;" FontFamily="Segoe Fluent Icons" FontSize="20"/>
                </Button>
                
                <Separator Style="{StaticResource ToolBarSeparatorStyle}"/>

                <!-- Remove -->
                <Button x:Name="RemoveButton" 
                        Click="Remove_Click" 
                        ToolTip="Remove selected locker(s) (Delete)"
                        Style="{StaticResource ToolBarButtonStyle}">
                    <TextBlock Text="&#xE74D;" FontFamily="Segoe Fluent Icons" FontSize="20"/>
                </Button>
                
                <Separator Style="{StaticResource ToolBarSeparatorStyle}"/>

                <!-- Select All -->
                <Button x:Name="SelectAllButton" 
                        Click="SelectAllToggle_Click" 
                        ToolTip="Select/Deselect all lockers"
                        Style="{StaticResource ToolBarButtonStyle}">
                    <TextBlock Text="&#xE8B3;" FontFamily="Segoe Fluent Icons" FontSize="20"/>
                </Button>

                <!-- View Toggle -->
                <Button x:Name="ViewToggleButton" 
                        Click="ToggleView_Click" 
                        ToolTip="Toggle View"
                        Style="{StaticResource ToolBarButtonStyle}">
                    <TextBlock x:Name="ViewToggleIcon" Text="&#xf2c7;" FontFamily="Segoe Fluent Icons" FontSize="20"/>
                </Button>

                <Separator Style="{StaticResource ToolBarSeparatorStyle}"/>

                <!-- Refresh -->
                <Button Click="Refresh_Click" 
                        ToolTip="Refresh locker list (F5)"
                        Style="{StaticResource ToolBarButtonStyle}">
                    <TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons" FontSize="20"/>
                </Button>
            </ToolBar>
        </ToolBarTray>
        </Border>

        <!-- Status Bar -->
        <StatusBar x:Name="MainStatusBar" DockPanel.Dock="Bottom">
            <StatusBarItem Style="{StaticResource StatusBarItemStyle}">
                <TextBlock x:Name="TotalLockersText" Text="0 lockers" Style="{StaticResource StatusBarTextStyle}"/>
            </StatusBarItem>
            <Separator Style="{StaticResource StatusBarSeparatorStyle}"/>
            <StatusBarItem Style="{StaticResource StatusBarItemStyle}">
                <TextBlock x:Name="LockedCountText" Text="0 locked" Style="{StaticResource StatusBarTextStyle}"/>
            </StatusBarItem>
            <Separator Style="{StaticResource StatusBarSeparatorStyle}"/>
            <StatusBarItem Style="{StaticResource StatusBarItemStyle}">
                <TextBlock x:Name="UnlockedCountText" Text="0 unlocked" Style="{StaticResource StatusBarTextStyle}"/>
            </StatusBarItem>
            <Separator Style="{StaticResource StatusBarSeparatorStyle}"/>
            <StatusBarItem Style="{StaticResource StatusBarItemStyle}">
                <TextBlock x:Name="SelectedCountText" Text="0 selected" Style="{StaticResource StatusBarTextStyle}"/>
            </StatusBarItem>
        </StatusBar>

        <!-- Main Content Area -->
        <Grid x:Name="ContentArea" Background="Transparent">
            <!-- Grid View (ListBox with WrapPanel) -->
            <ListBox x:Name="LockersGridView" 
                     Visibility="Visible"
                     SelectionMode="Multiple"
                     MouseDoubleClick="LockerItem_DoubleClick"
                     SelectionChanged="LockersView_SelectionChanged"
                     Padding="10"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" d:ItemsSource="{d:SampleData ItemCount=5}">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Margin" Value="4"/>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Width="150" Height="150" 
                                Background="{DynamicResource CardGradientBrush}"
                                CornerRadius="8" 
                                Padding="10"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                
                                <!-- Icon -->
                                <TextBlock Grid.Row="0" 
                                          Text="{Binding IconGlyph}" 
                                          FontFamily="Segoe Fluent Icons"
                                          FontSize="48"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Foreground="{DynamicResource TextPrimaryBrush}"/>
                                
                                <!-- Name -->
                                <TextBlock Grid.Row="1" 
                                          Text="{Binding Name}" 
                                          TextAlignment="Center"
                                          TextTrimming="CharacterEllipsis"
                                          TextWrapping="Wrap"
                                          MaxHeight="40"
                                          Foreground="{DynamicResource TextPrimaryBrush}"
                                          ToolTip="{Binding Name}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Select All" Click="SelectAll_Click" x:Name="ContextSelectAllItem"/>
                        <MenuItem Header="Deselect All" Click="DeselectAll_Click" x:Name="ContextDeselectAllItem"/>
                        <Separator/>
                        <MenuItem Header="Lock" Click="Lock_Click" x:Name="ContextLockItem"/>
                        <MenuItem Header="Unlock" Click="Unlock_Click" x:Name="ContextUnlockItem"/>
                        <Separator/>
                        <MenuItem Header="Remove" Click="Remove_Click"/>
                        <Separator/>
                        <MenuItem Header="Properties" Click="Properties_Click"/>
                        <MenuItem Header="Open Location" Click="OpenLocation_Click"/>
                    </ContextMenu>
                </ListBox.ContextMenu>
            </ListBox>

            <!-- List View -->
            <Grid x:Name="LockersListViewContainer" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <!-- Header Row -->
                <Grid Grid.Row="0" Background="{DynamicResource CardBackgroundBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="48"/> <!-- Checkbox Column -->
                        <ColumnDefinition Width="200"/> <!-- Name -->
                        <ColumnDefinition Width="120"/> <!-- Status -->
                        <ColumnDefinition Width="150"/> <!-- Last Modified -->
                        <ColumnDefinition Width="100"/> <!-- Size -->
                        <ColumnDefinition Width="*"/> <!-- Location -->
                    </Grid.ColumnDefinitions>
                    
                    <!-- Select All Checkbox -->
                    <CheckBox Grid.Column="0" 
                              x:Name="SelectAllCheckBox"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Margin="12,0,0,0"
                              Click="SelectAllCheckBox_Click"
                              ToolTip="Select/Deselect All"/>
                    
                    <!-- Column Headers -->
                    <Button Grid.Column="1" Content="Name" Click="SortByName_Click" 
                            Background="Transparent" BorderThickness="0" 
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="8,4"/>
                    
                    <Button Grid.Column="2" Content="Status" Click="SortByStatus_Click" 
                            Background="Transparent" BorderThickness="0" 
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="8,4"/>
                    
                    <Button Grid.Column="3" Content="Last Modified" Click="SortByLastModified_Click" 
                            Background="Transparent" BorderThickness="0" 
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="8,4"/>
                    
                    <Button Grid.Column="4" Content="Size" Click="SortBySize_Click" 
                            Background="Transparent" BorderThickness="0" 
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="8,4"/>
                    
                    <Button Grid.Column="5" Content="Location" Click="SortByLocation_Click" 
                            Background="Transparent" BorderThickness="0" 
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="8,4"/>
                </Grid>
                
                <!-- List View -->
                <ListView x:Name="LockersListView" 
                          Grid.Row="1"
                          SelectionMode="Multiple"
                          MouseDoubleClick="LockerItem_DoubleClick"
                          SelectionChanged="LockersView_SelectionChanged"
                          Background="Transparent"
                          BorderThickness="0">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Width="200" Header="">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" 
                                                  TextTrimming="CharacterEllipsis"
                                                  Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            
                            <GridViewColumn Width="120" Header="">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding IconGlyph}" 
                                                      FontFamily="Segoe Fluent Icons" 
                                                      FontSize="16" 
                                                      Margin="0,0,8,0"
                                                      Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding StatusText}"
                                                      Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            
                            <GridViewColumn Width="150" Header="">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding LastModified}"
                                                  Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            
                            <GridViewColumn Width="100" Header="">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding SizeText}"
                                                  Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            
                            <GridViewColumn Width="350" Header="">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Location}" 
                                                  TextTrimming="CharacterEllipsis"
                                                  Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                    <ListView.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Select All" Click="SelectAll_Click"/>
                            <MenuItem Header="Deselect All" Click="DeselectAll_Click"/>
                            <Separator/>
                            <MenuItem Header="Lock" Click="Lock_Click"/>
                            <MenuItem Header="Unlock" Click="Unlock_Click"/>
                            <Separator/>
                            <MenuItem Header="Remove" Click="Remove_Click"/>
                            <Separator/>
                            <MenuItem Header="Properties" Click="Properties_Click"/>
                            <MenuItem Header="Open Location" Click="OpenLocation_Click"/>
                        </ContextMenu>
                    </ListView.ContextMenu>
                </ListView>
            </Grid>
        </Grid>
    </DockPanel>
        </Border>
    </Border>
    
    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding CreateNewLockerCommand}"/>
        <KeyBinding Key="T" Modifiers="Control" Command="{Binding ToggleViewCommand}"/>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}"/>
        <KeyBinding Key="Delete" Command="{Binding RemoveSelectedCommand}"/>
    </Window.InputBindings>
</Window>
