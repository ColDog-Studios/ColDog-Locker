<Window x:Class="ColDogStudios.ColDogLocker.Gui.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="ColDog Locker" Height="600" Width="1000"
        Background="{DynamicResource BackgroundBrush}">
    
    <DockPanel>
        <!-- Menu Bar -->
        <Menu x:Name="MainMenu" DockPanel.Dock="Top">
            <!-- File Menu -->
            <MenuItem Header="_File">
                <MenuItem Header="_New Locker" Click="NewLocker_Click" InputGestureText="Ctrl+N">
                    <MenuItem.Icon>
                        <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="E_xit" Click="Exit_Click" InputGestureText="Alt+F4"/>
            </MenuItem>

            <!-- Locker Menu -->
            <MenuItem Header="_Locker">
                <MenuItem x:Name="LockMenuItem" Header="_Lock" Click="Lock_Click">
                    <MenuItem.Icon>
                        <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem x:Name="UnlockMenuItem" Header="_Unlock" Click="Unlock_Click">
                    <MenuItem.Icon>
                        <TextBlock Text="&#xE785;" FontFamily="Segoe MDL2 Assets"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem x:Name="RemoveMenuItem" Header="_Remove" Click="Remove_Click" InputGestureText="Delete">
                    <MenuItem.Icon>
                        <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem x:Name="PropertiesMenuItem" Header="_Properties" Click="Properties_Click"/>
                <MenuItem x:Name="OpenLocationMenuItem" Header="Open _Location" Click="OpenLocation_Click"/>
            </MenuItem>

            <!-- View Menu -->
            <MenuItem Header="_View">
                <MenuItem Header="_Toggle View" Click="ToggleView_Click" InputGestureText="Ctrl+T"/>
                <Separator/>
                <MenuItem Header="_Refresh" Click="Refresh_Click" InputGestureText="F5">
                    <MenuItem.Icon>
                        <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets"/>
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>

            <!-- Tools Menu -->
            <MenuItem Header="_Tools">
                <MenuItem Header="_Settings" Click="Settings_Click"/>
                <MenuItem Header="_Check for Updates" Click="CheckUpdates_Click"/>
            </MenuItem>

            <!-- Help Menu -->
            <MenuItem Header="_Help" Click="MenuItem_Click">
                <MenuItem Header="_Documentation" Click="Documentation_Click"/>
                <Separator/>
                <MenuItem Header="_About" Click="About_Click"/>
            </MenuItem>
        </Menu>

        <!-- Toolbar -->
        <ToolBarTray DockPanel.Dock="Top" IsLocked="True">
            <ToolBar x:Name="MainToolBar">
                <ToolBar.Resources>
                    <Style TargetType="{x:Type ToggleButton}" x:Key="{x:Static ToolBar.ToggleButtonStyleKey}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                    </Style>
                </ToolBar.Resources>
            <Button Click="NewLocker_Click" ToolTip="Create new locker (Ctrl+N)">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center"/>
                    <TextBlock Text="New Locker" Margin="5,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            
            <Separator/>
            
            <Button x:Name="LockButton" Click="Lock_Click" ToolTip="Lock selected locker(s)">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center"/>
                    <TextBlock Text="Lock" Margin="5,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            
            <Button x:Name="UnlockButton" Click="Unlock_Click" ToolTip="Unlock selected locker(s)">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE785;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center"/>
                    <TextBlock Text="Unlock" Margin="5,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            
            <Separator/>
            
            <Button x:Name="RemoveButton" Click="Remove_Click" ToolTip="Remove selected locker(s) (Delete)">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center"/>
                    <TextBlock Text="Remove" Margin="5,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            
            <Separator/>
            
            <Button x:Name="SelectAllButton" Click="SelectAllToggle_Click" ToolTip="Select/Deselect all lockers">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE8B3;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center"/>
                    <TextBlock Text="Select All" Margin="5,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            
            <Separator/>
            
            <Button x:Name="ViewToggleButton" Click="ToggleView_Click" ToolTip="Switch between grid and list view">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="ViewToggleIcon" Text="&#xE8FD;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center"/>
                    <TextBlock x:Name="ViewToggleLabel" Text="List View" Margin="5,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            
            <Button Click="Refresh_Click" ToolTip="Refresh locker list (F5)">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center"/>
                    <TextBlock Text="Refresh" Margin="5,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </ToolBar>
        </ToolBarTray>

        <!-- Status Bar -->
        <StatusBar x:Name="MainStatusBar" DockPanel.Dock="Bottom" Background="{DynamicResource CardBackgroundBrush}">
            <TextBlock x:Name="TotalLockersText" Text="0 lockers" Margin="0,0,20,0"/>
            <Separator/>
            <TextBlock x:Name="LockedCountText" Text="0 locked" Margin="0,0,20,0"/>
            <Separator/>
            <TextBlock x:Name="UnlockedCountText" Text="0 unlocked" Margin="0,0,20,0"/>
            <Separator/>
            <TextBlock x:Name="SelectedCountText" Text="0 selected"/>
        </StatusBar>

        <!-- Main Content Area -->
        <Grid x:Name="ContentArea" Background="{DynamicResource BackgroundBrush}">
            <!-- Grid View (ListBox with WrapPanel) -->
            <ListBox x:Name="LockersGridView" 
                     Visibility="Visible"
                     SelectionMode="Multiple"
                     MouseDoubleClick="LockerItem_DoubleClick"
                     SelectionChanged="LockersView_SelectionChanged"
                     Padding="10"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" d:ItemsSource="{d:SampleData ItemCount=5}">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Margin" Value="4"/>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Width="150" Height="150" 
                                Background="{DynamicResource CardBackgroundBrush}"
                                CornerRadius="8" 
                                Padding="10"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                
                                <!-- Icon -->
                                <TextBlock Grid.Row="0" 
                                          Text="{Binding IconGlyph}" 
                                          FontFamily="Segoe MDL2 Assets"
                                          FontSize="48"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Foreground="{DynamicResource TextPrimaryBrush}"/>
                                
                                <!-- Name -->
                                <TextBlock Grid.Row="1" 
                                          Text="{Binding Name}" 
                                          TextAlignment="Center"
                                          TextTrimming="CharacterEllipsis"
                                          TextWrapping="Wrap"
                                          MaxHeight="40"
                                          Foreground="{DynamicResource TextPrimaryBrush}"
                                          ToolTip="{Binding Name}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Select All" Click="SelectAll_Click" x:Name="ContextSelectAllItem"/>
                        <MenuItem Header="Deselect All" Click="DeselectAll_Click" x:Name="ContextDeselectAllItem"/>
                        <Separator/>
                        <MenuItem Header="Lock" Click="Lock_Click" x:Name="ContextLockItem"/>
                        <MenuItem Header="Unlock" Click="Unlock_Click" x:Name="ContextUnlockItem"/>
                        <Separator/>
                        <MenuItem Header="Remove" Click="Remove_Click"/>
                        <Separator/>
                        <MenuItem Header="Properties" Click="Properties_Click"/>
                        <MenuItem Header="Open Location" Click="OpenLocation_Click"/>
                    </ContextMenu>
                </ListBox.ContextMenu>
            </ListBox>

            <!-- List View -->
            <Grid x:Name="LockersListViewContainer" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <!-- Header Row -->
                <Grid Grid.Row="0" Background="{DynamicResource CardBackgroundBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="48"/> <!-- Checkbox Column -->
                        <ColumnDefinition Width="200"/> <!-- Name -->
                        <ColumnDefinition Width="120"/> <!-- Status -->
                        <ColumnDefinition Width="150"/> <!-- Last Modified -->
                        <ColumnDefinition Width="100"/> <!-- Size -->
                        <ColumnDefinition Width="*"/> <!-- Location -->
                    </Grid.ColumnDefinitions>
                    
                    <!-- Select All Checkbox -->
                    <CheckBox Grid.Column="0" 
                              x:Name="SelectAllCheckBox"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Margin="12,0,0,0"
                              Click="SelectAllCheckBox_Click"
                              ToolTip="Select/Deselect All"/>
                    
                    <!-- Column Headers -->
                    <Button Grid.Column="1" Content="Name" Click="SortByName_Click" 
                            Background="Transparent" BorderThickness="0" 
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="8,4"/>
                    
                    <Button Grid.Column="2" Content="Status" Click="SortByStatus_Click" 
                            Background="Transparent" BorderThickness="0" 
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="8,4"/>
                    
                    <Button Grid.Column="3" Content="Last Modified" Click="SortByLastModified_Click" 
                            Background="Transparent" BorderThickness="0" 
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="8,4"/>
                    
                    <Button Grid.Column="4" Content="Size" Click="SortBySize_Click" 
                            Background="Transparent" BorderThickness="0" 
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="8,4"/>
                    
                    <Button Grid.Column="5" Content="Location" Click="SortByLocation_Click" 
                            Background="Transparent" BorderThickness="0" 
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="8,4"/>
                </Grid>
                
                <!-- List View -->
                <ListView x:Name="LockersListView" 
                          Grid.Row="1"
                          SelectionMode="Multiple"
                          MouseDoubleClick="LockerItem_DoubleClick"
                          SelectionChanged="LockersView_SelectionChanged"
                          Background="Transparent"
                          BorderThickness="0">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Width="200" Header="">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" 
                                                  TextTrimming="CharacterEllipsis"
                                                  Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            
                            <GridViewColumn Width="120" Header="">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding IconGlyph}" 
                                                      FontFamily="Segoe MDL2 Assets" 
                                                      FontSize="16" 
                                                      Margin="0,0,8,0"
                                                      Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding StatusText}"
                                                      Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            
                            <GridViewColumn Width="150" Header="">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding LastModified}"
                                                  Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            
                            <GridViewColumn Width="100" Header="">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding SizeText}"
                                                  Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            
                            <GridViewColumn Width="350" Header="">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Location}" 
                                                  TextTrimming="CharacterEllipsis"
                                                  Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                    <ListView.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Select All" Click="SelectAll_Click"/>
                            <MenuItem Header="Deselect All" Click="DeselectAll_Click"/>
                            <Separator/>
                            <MenuItem Header="Lock" Click="Lock_Click"/>
                            <MenuItem Header="Unlock" Click="Unlock_Click"/>
                            <Separator/>
                            <MenuItem Header="Remove" Click="Remove_Click"/>
                            <Separator/>
                            <MenuItem Header="Properties" Click="Properties_Click"/>
                            <MenuItem Header="Open Location" Click="OpenLocation_Click"/>
                        </ContextMenu>
                    </ListView.ContextMenu>
                </ListView>
            </Grid>
        </Grid>
    </DockPanel>
    
    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding CreateNewLockerCommand}"/>
        <KeyBinding Key="T" Modifiers="Control" Command="{Binding ToggleViewCommand}"/>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}"/>
        <KeyBinding Key="Delete" Command="{Binding RemoveSelectedCommand}"/>
    </Window.InputBindings>
</Window>
