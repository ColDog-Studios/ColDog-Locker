<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>ColDogStudios.ColDogLocker.Gui.WPF</RootNamespace>
    <AssemblyName>ColDogLocker</AssemblyName>
    <ApplicationIcon>cdlIcon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.6" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ColDogLocker.Core\ColDogLocker.Core.csproj" />
    <ProjectReference Include="..\ColDogLocker.Infrastructure\ColDogLocker.Infrastructure.csproj" />
    <ProjectReference Include="..\ColDogLocker.Application\ColDogLocker.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="cdlIcon.ico" />
  </ItemGroup>

</Project>
