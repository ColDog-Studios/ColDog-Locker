<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0-windows</TargetFramework>
        <EnableWindowsTargeting>true</EnableWindowsTargeting>
        <UseWPF>true</UseWPF>
        <RootNamespace>ColDogStudios.ColDogLocker.Gui.WPF</RootNamespace>
        <AssemblyName>ColDogLocker</AssemblyName>
        <ApplicationIcon>cdlIcon.ico</ApplicationIcon>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="CommunityToolkit.Mvvm"/>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\ColDogLocker.Core\ColDogLocker.Core.csproj"/>
        <ProjectReference Include="..\ColDogLocker.Services\ColDogLocker.Services.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <Resource Include="cdlIcon.ico"/>
    </ItemGroup>

</Project>
