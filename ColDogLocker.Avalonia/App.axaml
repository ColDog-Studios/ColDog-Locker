<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ColDogStudios.ColDogLocker.Avalonia.App"
             xmlns:local="using:ColDogStudios.ColDogLocker.Avalonia"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             RequestedThemeVariant="Default">
    <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <SolidColorBrush x:Key="AppPrimaryBrush" Color="#0096DC" />
            <SolidColorBrush x:Key="AppAccentBrush" Color="#0077B6" />
            <SolidColorBrush x:Key="AppMenuBackgroundBrush" Color="#F0F0F0" />
            <SolidColorBrush x:Key="AppMenuForegroundBrush" Color="#1F2933" />
            <SolidColorBrush x:Key="AppForegroundBrush" Color="#1F2933" />
            <SolidColorBrush x:Key="AppSecondaryForegroundBrush" Color="#4A5568" />
            <SolidColorBrush x:Key="AppBorderBrush" Color="#D7DEE5" />
            <SolidColorBrush x:Key="AppToolbarBackgroundBrush" Color="#FAFAFA" />
            <SolidColorBrush x:Key="AppTableHeaderBackgroundBrush" Color="#F1F5F9" />
            <SolidColorBrush x:Key="AppCardBackgroundBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="AppStatusBackgroundBrush" Color="#FAFAFA" />
            <SolidColorBrush x:Key="AppButtonBackgroundBrush" Color="#0077B6" />
            <SolidColorBrush x:Key="AppButtonHoverBackgroundBrush" Color="#0096DC" />
            <SolidColorBrush x:Key="AppButtonPressedBackgroundBrush" Color="#002E44" />
            <SolidColorBrush x:Key="AppButtonForegroundBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="UnlockedStatusBrush" Color="#0077B6" />
            <SolidColorBrush x:Key="LockedStatusBrush" Color="#FF6923" />

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="AppMenuBackgroundBrush" Color="#F0F0F0" />
                    <SolidColorBrush x:Key="AppMenuForegroundBrush" Color="#1F2933" />
                    <SolidColorBrush x:Key="AppForegroundBrush" Color="#1F2933" />
                    <SolidColorBrush x:Key="AppSecondaryForegroundBrush" Color="#4A5568" />
                    <SolidColorBrush x:Key="AppToolbarBackgroundBrush" Color="#FAFAFA" />
                    <SolidColorBrush x:Key="AppTableHeaderBackgroundBrush" Color="#F1F5F9" />
                    <SolidColorBrush x:Key="AppCardBackgroundBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="AppStatusBackgroundBrush" Color="#FAFAFA" />
                    <SolidColorBrush x:Key="AppBorderBrush" Color="#D7DEE5" />
                    <SolidColorBrush x:Key="AppButtonBackgroundBrush" Color="#0077B6" />
                    <SolidColorBrush x:Key="AppButtonHoverBackgroundBrush" Color="#0096DC" />
                    <SolidColorBrush x:Key="AppButtonPressedBackgroundBrush" Color="#002E44" />
                    <SolidColorBrush x:Key="AppButtonForegroundBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="UnlockedStatusBrush" Color="#0077B6" />
                    <SolidColorBrush x:Key="LockedStatusBrush" Color="#FF6923" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="AppMenuBackgroundBrush" Color="#1F1F1F" />
                    <SolidColorBrush x:Key="AppMenuForegroundBrush" Color="#F7FAFC" />
                    <SolidColorBrush x:Key="AppForegroundBrush" Color="#F7FAFC" />
                    <SolidColorBrush x:Key="AppSecondaryForegroundBrush" Color="#CBD5E1" />
                    <SolidColorBrush x:Key="AppToolbarBackgroundBrush" Color="#333333" />
                    <SolidColorBrush x:Key="AppTableHeaderBackgroundBrush" Color="#2A2A2A" />
                    <SolidColorBrush x:Key="AppCardBackgroundBrush" Color="#2A2A2A" />
                    <SolidColorBrush x:Key="AppStatusBackgroundBrush" Color="#333333" />
                    <SolidColorBrush x:Key="AppBorderBrush" Color="#4A4A4A" />
                    <SolidColorBrush x:Key="AppButtonBackgroundBrush" Color="#0077B6" />
                    <SolidColorBrush x:Key="AppButtonHoverBackgroundBrush" Color="#0096DC" />
                    <SolidColorBrush x:Key="AppButtonPressedBackgroundBrush" Color="#005F91" />
                    <SolidColorBrush x:Key="AppButtonForegroundBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="UnlockedStatusBrush" Color="#0077B6" />
                    <SolidColorBrush x:Key="LockedStatusBrush" Color="#FF6923" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <materialIcons:MaterialIconStyles />
        <Style Selector="Button.accent-button">
            <Setter Property="Background" Value="{DynamicResource AppButtonBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppButtonBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AppButtonForegroundBrush}" />
        </Style>
        <Style Selector="Button.accent-button:pointerover">
            <Setter Property="Background" Value="{DynamicResource AppButtonHoverBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppButtonHoverBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AppButtonForegroundBrush}" />
        </Style>
        <Style Selector="Button.accent-button:pressed">
            <Setter Property="Background" Value="{DynamicResource AppButtonPressedBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppButtonPressedBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AppButtonForegroundBrush}" />
        </Style>
        <Style Selector="Button.tool-button">
            <Setter Property="Foreground" Value="{DynamicResource AppPrimaryBrush}" />
        </Style>
        <Style Selector="Button.tool-button materialIcons|MaterialIcon">
            <Setter Property="Foreground" Value="{DynamicResource AppPrimaryBrush}" />
        </Style>
        <Style Selector="Button.tool-button:pointerover">
            <Setter Property="Background" Value="{DynamicResource AppButtonHoverBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppButtonHoverBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AppButtonForegroundBrush}" />
        </Style>
        <Style Selector="Button.tool-button:pointerover materialIcons|MaterialIcon">
            <Setter Property="Foreground" Value="{DynamicResource AppButtonForegroundBrush}" />
        </Style>
        <Style Selector="Button.tool-button:pressed">
            <Setter Property="Background" Value="{DynamicResource AppButtonPressedBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppButtonPressedBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AppButtonForegroundBrush}" />
        </Style>
        <Style Selector="Button.tool-button:pressed materialIcons|MaterialIcon">
            <Setter Property="Foreground" Value="{DynamicResource AppButtonForegroundBrush}" />
        </Style>
        <Style Selector="MenuItem materialIcons|MaterialIcon">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
        </Style>
        <Style Selector="ToggleButton:pointerover">
            <Setter Property="Background" Value="{DynamicResource AppButtonHoverBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppButtonHoverBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AppButtonForegroundBrush}" />
        </Style>
        <Style Selector="ToggleButton:pressed">
            <Setter Property="Background" Value="{DynamicResource AppButtonPressedBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppButtonPressedBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AppButtonForegroundBrush}" />
        </Style>
    </Application.Styles>
</Application>
