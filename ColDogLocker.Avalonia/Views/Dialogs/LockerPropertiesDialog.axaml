<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="560"
        d:DesignHeight="600"
        x:Class="ColDogStudios.ColDogLocker.Avalonia.Views.Dialogs.LockerPropertiesDialog"
        Title="Locker Properties"
        Width="560"
        Height="600"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

    <Grid RowDefinitions="*,Auto">
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="18" Spacing="18">
                <Border Padding="14"
                        BorderThickness="1"
                        CornerRadius="6">
                    <StackPanel Spacing="10">
                        <TextBlock Text="General"
                                   FontSize="16"
                                   FontWeight="SemiBold" />

                        <StackPanel Spacing="4">
                            <TextBlock Text="Name" FontWeight="SemiBold" />
                            <TextBox x:Name="NameBox" />
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="Location" FontWeight="SemiBold" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBox x:Name="LocationBox"
                                         Grid.Column="0"
                                         IsReadOnly="True" />
                                <Button x:Name="BrowseButton"
                                        Grid.Column="1"
                                        Classes="accent-button"
                                        Content="Browse..."
                                        MinWidth="92"
                                        Padding="14,6"
                                        HorizontalContentAlignment="Center" />
                            </Grid>
                        </StackPanel>

                        <TextBlock x:Name="LocationWarningText"
                                   Text="Location cannot be changed while the locker is locked."
                                   FontSize="12"
                                   Foreground="#FF6923"
                                   TextWrapping="Wrap"
                                   IsVisible="False" />

                        <Grid ColumnDefinitions="150,*" ColumnSpacing="12">
                            <TextBlock Grid.Column="0"
                                       Text="Status"
                                       FontWeight="SemiBold" />
                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        Spacing="6">
                                <materialIcons:MaterialIcon x:Name="StatusIcon"
                                                            Width="18"
                                                            Height="18" />
                                <TextBlock x:Name="StatusText"
                                           FontWeight="SemiBold" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Padding="14"
                        BorderThickness="1"
                        CornerRadius="6">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Storage"
                                   FontSize="16"
                                   FontWeight="SemiBold" />
                        <Grid ColumnDefinitions="150,*" ColumnSpacing="12">
                            <TextBlock Grid.Column="0"
                                       Text="Size"
                                       FontWeight="SemiBold" />
                            <TextBlock x:Name="SizeText"
                                       Grid.Column="1"
                                       Opacity="0.78"
                                       TextWrapping="Wrap" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Padding="14"
                        BorderThickness="1"
                        CornerRadius="6">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Dates"
                                   FontSize="16"
                                   FontWeight="SemiBold" />
                        <Grid ColumnDefinitions="150,*" ColumnSpacing="12">
                            <TextBlock Grid.Column="0"
                                       Text="Created"
                                       FontWeight="SemiBold" />
                            <TextBlock x:Name="CreatedText"
                                       Grid.Column="1"
                                       Opacity="0.78"
                                       TextWrapping="Wrap" />
                        </Grid>
                        <Grid ColumnDefinitions="150,*" ColumnSpacing="12">
                            <TextBlock Grid.Column="0"
                                       Text="Last Modified"
                                       FontWeight="SemiBold" />
                            <TextBlock x:Name="ModifiedText"
                                       Grid.Column="1"
                                       Opacity="0.78"
                                       TextWrapping="Wrap" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Padding="18">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="8">
                <Button x:Name="SaveButton"
                        Classes="accent-button"
                        Content="Save"
                        IsEnabled="False"
                        MinWidth="92"
                        Padding="14,6"
                        HorizontalContentAlignment="Center" />
                <Button x:Name="CloseButton"
                        Classes="accent-button"
                        Content="Close"
                        MinWidth="92"
                        Padding="14,6"
                        HorizontalContentAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
