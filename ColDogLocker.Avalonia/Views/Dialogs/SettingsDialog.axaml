<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="680"
        d:DesignHeight="620"
        x:Class="ColDogStudios.ColDogLocker.Avalonia.Views.Dialogs.SettingsDialog"
        Title="Settings"
        Width="680"
        Height="620"
        MinWidth="620"
        MinHeight="520"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

    <Window.Styles>
        <Style Selector="Border.settings-section">
            <Setter Property="Padding" Value="14" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style Selector="TextBlock.section-title">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.section-description">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Opacity" Value="0.75" />
        </Style>
        <Style Selector="TextBlock.field-label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.settings-tab-header">
            <Setter Property="FontSize" Value="18" />
        </Style>
        <Style Selector="ComboBox.narrow">
            <Setter Property="Width" Value="160" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style Selector="TextBox.narrow">
            <Setter Property="Width" Value="160" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="*,Auto">
        <TabControl Grid.Row="0" Margin="16,16,16,0">
            <TabItem>
                <TabItem.Header>
                    <TextBlock Classes="settings-tab-header" Text="General" />
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20" Spacing="18">
                        <Border Classes="settings-section">
                            <StackPanel Spacing="8">
                                <TextBlock Classes="section-title" Text="Default Locker Location" />
                                <TextBlock Classes="section-description"
                                           Text="New lockers will be created in this folder by default." />
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <TextBox x:Name="DefaultLocationTextBox"
                                             Grid.Column="0"
                                             IsReadOnly="True" />
                                    <Button x:Name="BrowseDefaultLocationButton"
                                            Grid.Column="1"
                                            Classes="accent-button"
                                            Content="Browse..."
                                            MinWidth="92"
                                            Padding="14,6"
                                            HorizontalContentAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <TextBlock Classes="settings-tab-header" Text="Appearance" />
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20" Spacing="18">
                        <Border Classes="settings-section">
                            <StackPanel Spacing="8">
                                <TextBlock Classes="section-title" Text="Theme" />
                                <TextBlock Classes="section-description"
                                           Text="Choose the application color theme." />
                                <ComboBox x:Name="ThemeBox" Classes="narrow" />
                            </StackPanel>
                        </Border>

                        <Border Classes="settings-section">
                            <StackPanel Spacing="8">
                                <TextBlock Classes="section-title" Text="Default View" />
                                <RadioButton x:Name="GridViewRadio"
                                             Content="Grid View (Tiles)"
                                             GroupName="DefaultView" />
                                <RadioButton x:Name="ListViewRadio"
                                             Content="List View (Details)"
                                             GroupName="DefaultView" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <TextBlock Classes="settings-tab-header" Text="Updates" />
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20" Spacing="18">
                        <Border Classes="settings-section">
                            <StackPanel Spacing="8">
                                <TextBlock Classes="section-title" Text="Update Checks" />
                                <CheckBox x:Name="AutoUpdateCheckBox" Content="Enable Auto Update" />
                            </StackPanel>
                        </Border>

                        <Border Classes="settings-section">
                            <StackPanel Spacing="8">
                                <TextBlock Classes="section-title" Text="Update Channel" />
                                <TextBlock Classes="section-description"
                                           Text="Choose which type of updates you want to receive." />
                                <RadioButton x:Name="StableChannelRadio"
                                             Content="Stable (Recommended)"
                                             GroupName="UpdateChannel" />
                                <TextBlock Classes="section-description"
                                           Margin="22,0,0,0"
                                           Text="Receive only stable, tested releases." />
                                <RadioButton x:Name="UnstableChannelRadio"
                                             Content="Unstable"
                                             GroupName="UpdateChannel" />
                                <TextBlock Classes="section-description"
                                           Margin="22,0,0,0"
                                           Text="Receive the newest available release, including unstable builds." />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <TextBlock Classes="settings-tab-header" Text="Logging" />
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20" Spacing="18">
                        <Border Classes="settings-section">
                            <StackPanel Spacing="8">
                                <TextBlock Classes="section-title" Text="Basic Logging Options" />
                                <CheckBox x:Name="DevModeCheckBox" Content="Enable dev mode" />
                                <CheckBox x:Name="EnableFileLoggingCheckBox" Content="Enable file logging" />
                            </StackPanel>
                        </Border>

                        <Border Classes="settings-section">
                            <StackPanel Spacing="8">
                                <TextBlock Classes="section-title" Text="Minimum Log Level" />
                                <TextBlock Classes="section-description"
                                           Text="Only log messages at or above this level." />
                                <ComboBox x:Name="LogLevelBox" Classes="narrow" />
                            </StackPanel>
                        </Border>

                        <Border Classes="settings-section">
                            <StackPanel Spacing="8">
                                <TextBlock Classes="section-title" Text="Log Format" />
                                <TextBlock Classes="section-description"
                                           Text="Choose how log entries are formatted." />
                                <ComboBox x:Name="LogFormatBox" Classes="narrow" />
                            </StackPanel>
                        </Border>

                        <Border Classes="settings-section">
                            <StackPanel Spacing="8">
                                <TextBlock Classes="section-title" Text="Log File Rotation" />
                                <TextBlock Classes="section-description"
                                           Text="Automatically rotate log files based on size." />
                                <StackPanel Spacing="4">
                                    <TextBlock Classes="field-label" Text="Max file size (MB)" />
                                    <TextBox x:Name="MaxFileSizeTextBox" Classes="narrow" />
                                </StackPanel>
                                <StackPanel Spacing="4">
                                    <TextBlock Classes="field-label" Text="Max retained files" />
                                    <TextBox x:Name="MaxRetainedFilesTextBox" Classes="narrow" />
                                </StackPanel>
                                <CheckBox x:Name="EnableCompressionCheckBox"
                                          Content="Compress rotated log files (.gz)" />
                            </StackPanel>
                        </Border>

                        <Border Classes="settings-section">
                            <StackPanel Spacing="8">
                                <TextBlock Classes="section-title" Text="Advanced Options" />
                                <CheckBox x:Name="IncludeTimestampsCheckBox"
                                          Content="Include timestamps in log entries" />
                                <CheckBox x:Name="IncludeThreadIdCheckBox"
                                          Content="Include thread ID in log entries" />
                                <StackPanel Spacing="4">
                                    <TextBlock Classes="field-label" Text="Date/time format" />
                                    <ComboBox x:Name="DateTimeFormatBox" Classes="narrow" />
                                </StackPanel>
                                <CheckBox x:Name="AsyncLoggingCheckBox"
                                          Content="Enable asynchronous logging" />
                            </StackPanel>
                        </Border>

                        <Border Classes="settings-section">
                            <StackPanel Spacing="8">
                                <TextBlock Classes="section-title" Text="Logs" />
                                <Button x:Name="OpenLogsFolderButton"
                                        Classes="accent-button"
                                        Content="Open Logs Folder"
                                        HorizontalAlignment="Left"
                                        MinWidth="92"
                                        Padding="14,6"
                                        HorizontalContentAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <TextBlock Classes="settings-tab-header" Text="Database" />
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20" Spacing="18">
                        <Border Classes="settings-section">
                            <StackPanel Spacing="8">
                                <TextBlock Classes="section-title" Text="Database Maintenance" />
                                <TextBlock Classes="section-description"
                                           Text="Optimize the database to improve performance and reclaim disk space." />
                                <StackPanel Spacing="4">
                                    <TextBlock Classes="field-label" Text="Auto-vacuum interval (days)" />
                                    <TextBox x:Name="DbVacuumIntervalTextBox" Classes="narrow" />
                                </StackPanel>
                                <Button x:Name="VacuumDatabaseButton"
                                        Classes="accent-button"
                                        Content="Vacuum Database Now"
                                        HorizontalAlignment="Left"
                                        MinWidth="92"
                                        Padding="14,6"
                                        HorizontalContentAlignment="Center" />
                                <TextBlock Classes="section-description"
                                           Text="Manually optimize database and reclaim unused space." />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <TextBlock Classes="settings-tab-header" Text="Advanced" />
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20" Spacing="18">
                        <Border Classes="settings-section">
                            <StackPanel Spacing="8">
                                <TextBlock Classes="section-title" Text="Performance" />
                                <CheckBox x:Name="EnableAnimationsCheckBox"
                                          Content="Enable UI animations" />
                                <TextBlock Classes="section-description"
                                           Margin="22,0,0,0"
                                           Text="Disable for better performance on slower systems." />
                            </StackPanel>
                        </Border>

                        <Border Classes="settings-section">
                            <StackPanel Spacing="8">
                                <TextBlock Classes="section-title" Text="Data Management" />
                                <Button x:Name="ClearCacheButton"
                                        Classes="accent-button"
                                        Content="Clear Application Cache"
                                        HorizontalAlignment="Left"
                                        MinWidth="92"
                                        Padding="14,6"
                                        HorizontalContentAlignment="Center" />
                                <TextBlock Classes="section-description"
                                           Text="Removes temporary files and cached data when implemented." />
                                <Button x:Name="ResetSettingsButton"
                                        Classes="accent-button"
                                        Content="Reset All Settings"
                                        HorizontalAlignment="Left"
                                        MinWidth="92"
                                        Padding="14,6"
                                        HorizontalContentAlignment="Center" />
                                <TextBlock Classes="section-description"
                                           Text="Restores all settings to their default values." />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Border Grid.Row="1" Padding="16">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="8">
                <Button x:Name="RestoreDefaultsButton"
                        Classes="accent-button"
                        Content="Restore Defaults"
                        MinWidth="92"
                        Padding="14,6"
                        HorizontalContentAlignment="Center" />
                <Button x:Name="CancelButton"
                        Classes="accent-button"
                        Content="Cancel"
                        MinWidth="92"
                        Padding="14,6"
                        HorizontalContentAlignment="Center" />
                <Button x:Name="SaveButton"
                        Classes="accent-button"
                        Content="Save"
                        MinWidth="92"
                        Padding="14,6"
                        HorizontalContentAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
