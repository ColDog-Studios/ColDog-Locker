<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="420"
        d:DesignHeight="190"
        x:Class="ColDogStudios.ColDogLocker.Avalonia.Views.Dialogs.PasswordDialog"
        Title="Password"
        Width="420"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

    <StackPanel Margin="18" Spacing="16">
        <StackPanel Spacing="4">
            <TextBlock x:Name="PasswordLabel" Text="Password"
                       FontWeight="SemiBold"
                       Margin="0,0,0,4" />
            <TextBox x:Name="PasswordBox"
                     AutomationProperties.LabeledBy="{Binding #PasswordLabel}"
                     PasswordChar="*"
                     PlaceholderText="Password" />
        </StackPanel>

        <StackPanel x:Name="ConfirmationPanel" Spacing="4" IsVisible="False">
            <TextBlock x:Name="ConfirmationLabel" Text="Confirm new password"
                       FontWeight="SemiBold" Margin="0,0,0,4" />
            <TextBox x:Name="ConfirmPasswordBox"
                     AutomationProperties.LabeledBy="{Binding #ConfirmationLabel}"
                     PasswordChar="*"
                     PlaceholderText="Confirm new password" />
            <TextBlock x:Name="MismatchText" Text="Passwords do not match."
                       IsVisible="False" Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}" />
        </StackPanel>

        <StackPanel x:Name="PasswordRequirementsContainer" Spacing="6" IsVisible="False">
            <TextBlock Text="Password requirements" FontWeight="SemiBold" />
            <StackPanel x:Name="PasswordRequirementsPanel" Spacing="4" />
        </StackPanel>
        <CheckBox x:Name="ShowPasswordCheckBox" Content="Show password" AutomationProperties.Name="Show password" />
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8">
            <Button x:Name="CancelButton"
                    Classes="accent-button"
                    Content="Cancel"
                    IsCancel="True"
                    MinWidth="92"
                    Padding="14,6"
                    HorizontalContentAlignment="Center" />
            <Button x:Name="OkButton"
                    Classes="accent-button"
                    Content="OK"
                    IsDefault="True"
                    IsEnabled="False"
                    MinWidth="92"
                    Padding="14,6"
                    HorizontalContentAlignment="Center" />
        </StackPanel>
    </StackPanel>
</Window>
