<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>ColDogStudios.ColDogLocker.Console</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Title>ColDog Locker Console</Title>
    <Version>0.1.0-pre</Version>
    <Company>ColDog Studios</Company>
    <Authors>ColDog Studios</Authors>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/ColDog-Studios/ColDog-Locker</RepositoryUrl>
    <Platforms>AnyCPU;x64</Platforms>
    <!-- Icon references using CDL (ColDog Locker) icons -->
    <ApplicationIcon>..\..\images\icons\cdlIcon-32.ico</ApplicationIcon>
    <PackageIcon>cdlIcon-128.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ColDogStudios.ColDogLocker.Core\ColDogStudios.ColDogLocker.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.3">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <None Update="..\..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\..\images\icons\cdlIcon-128.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <Target Name="PreBuild" BeforeTargets="PreBuildEvent">
    <Exec Command="powershell -ExecutionPolicy Bypass -File ..\..\scripts\Pre-Build.ps1" />
  </Target>

</Project>
