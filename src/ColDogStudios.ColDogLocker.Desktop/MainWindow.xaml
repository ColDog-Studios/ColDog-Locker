<Window x:Class="ColDogStudios.ColDogLocker.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ColDogStudios.ColDogLocker.Desktop"
        Title="ColDog Locker" 
        Height="600" 
        Width="1000"
        WindowStartupLocation="CenterScreen">
    
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <local:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
    </Window.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Menu -->
            <RowDefinition Height="Auto"/> <!-- Toolbar -->
            <RowDefinition Height="*"/>    <!-- Content -->
            <RowDefinition Height="Auto"/> <!-- Status Bar -->
        </Grid.RowDefinitions>

        <!-- Menu Bar -->
        <Menu Grid.Row="0" Background="#EEEEEE">
            <MenuItem Header="_File">
                <MenuItem Header="_New Locker" Command="{Binding CreateLockerCommand}"/>
                <Separator/>
                <MenuItem Header="_Exit" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="_Remove Selected" Command="{Binding DeleteCommand}"/>
                <Separator/>
                <MenuItem Header="_Settings" Command="{Binding SettingsCommand}"/>
            </MenuItem>
            <MenuItem Header="_Actions">
                <MenuItem Header="_Lock" Command="{Binding LockCommand}"/>
                <MenuItem Header="_Unlock" Command="{Binding UnlockCommand}"/>
                <Separator/>
                <MenuItem Header="_Refresh" Command="{Binding LoadLockersCommand}"/>
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="_Toggle View" Command="{Binding ToggleViewCommand}"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About" Command="{Binding AboutCommand}"/>
            </MenuItem>
        </Menu>

        <!-- Toolbar -->
        <ToolBar Grid.Row="1" Background="#EEEEEE" ToolBarTray.IsLocked="True">
            <Button Content="New" Command="{Binding CreateLockerCommand}" ToolTip="Create New Locker" MinWidth="50" Padding="5,2"/>
            <Button Content="Remove" Command="{Binding DeleteCommand}" ToolTip="Remove Selected Locker" MinWidth="60" Padding="5,2"/>
            <Separator/>
            <Button Content="Lock" Command="{Binding LockCommand}" ToolTip="Lock Selected Locker" MinWidth="45" Padding="5,2"/>
            <Button Content="Unlock" Command="{Binding UnlockCommand}" ToolTip="Unlock Selected Locker" MinWidth="55" Padding="5,2"/>
            <Separator/>
            <Button Content="Refresh" Command="{Binding LoadLockersCommand}" ToolTip="Refresh Locker List" MinWidth="60" Padding="5,2"/>
            <Button Content="Settings" Command="{Binding SettingsCommand}" ToolTip="Open Settings" MinWidth="60" Padding="5,2"/>
            <Separator/>
            <Button Content="Toggle View" Command="{Binding ToggleViewCommand}" ToolTip="Toggle Between Grid and List View" MinWidth="80" Padding="5,2"/>
        </ToolBar>

        <!-- Main Content Area -->
        <Grid Grid.Row="2" Margin="5">
            <!-- List View (Table) -->
            <DataGrid x:Name="LockersDataGrid"
                      ItemsSource="{Binding Lockers}"
                      SelectedItem="{Binding SelectedLocker}"
                      SelectionChanged="DataGrid_SelectionChanged"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      Visibility="{Binding IsGridView, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Name" Binding="{Binding LockerName}" Width="*" MinWidth="150"/>
                    <DataGridTextColumn Header="Path" Binding="{Binding LockerPath}" Width="2*" MinWidth="200"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="100" MinWidth="80"/>
                    <DataGridTextColumn Header="File Count" Binding="{Binding FileCount}" Width="100" MinWidth="80"/>
                    <DataGridTextColumn Header="Last Modified" Binding="{Binding LastModified, StringFormat=g}" Width="150" MinWidth="120"/>
                </DataGrid.Columns>
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Lock" Command="{Binding LockCommand}"/>
                        <MenuItem Header="Unlock" Command="{Binding UnlockCommand}"/>
                        <Separator/>
                        <MenuItem Header="Remove" Command="{Binding RemoveLockerCommand}"/>
                        <Separator/>
                        <MenuItem Header="Refresh" Command="{Binding RefreshCommand}"/>
                    </ContextMenu>
                </DataGrid.ContextMenu>
            </DataGrid>

            <!-- Grid View -->
            <ListView x:Name="LockersListView" 
                      ItemsSource="{Binding Lockers}"
                      SelectedItem="{Binding SelectedLocker}"
                      Visibility="{Binding IsGridView, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Background="White" 
                                BorderBrush="#E0E0E0" 
                                BorderThickness="1" 
                                Padding="10" 
                                Margin="5"
                                Width="200" 
                                Height="120">
                            <StackPanel>
                                <TextBlock Text="{Binding LockerName}" 
                                           FontWeight="Bold" 
                                           FontSize="14" 
                                           Margin="0,0,0,5"/>
                                <TextBlock Text="{Binding StatusText}" 
                                           Foreground="{Binding IsLocked, Converter={x:Static local:Converters+BooleanToStatusColorConverter.Instance}}"
                                           Margin="0,0,0,3"/>
                                <TextBlock Text="{Binding FileCount, StringFormat='{}{0} files'}" 
                                           Foreground="Gray" 
                                           Margin="0,0,0,3"/>
                                <TextBlock Text="{Binding LastModified, StringFormat=g}" 
                                           Foreground="Gray" 
                                           FontSize="10"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
                <ListView.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Lock" Command="{Binding LockCommand}"/>
                        <MenuItem Header="Unlock" Command="{Binding UnlockCommand}"/>
                        <Separator/>
                        <MenuItem Header="Remove" Command="{Binding RemoveLockerCommand}"/>
                        <Separator/>
                        <MenuItem Header="Refresh" Command="{Binding RefreshCommand}"/>
                    </ContextMenu>
                </ListView.ContextMenu>
            </ListView>
        </Grid>

        <!-- Status Bar -->
        <StatusBar Grid.Row="3" Background="#EEEEEE">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Lockers.Count, StringFormat='{}{0} lockers'}" Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding IsOperationInProgress, Converter={x:Static local:Converters+BooleanToOperationTextConverter.Instance}}"/>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
