    <!-- <BitmapImage x:Key="SuccessIcon" UriSource="pack://application:,,,/../../images/ui/dialogs/success-icon.png"/> -->
    
    <!-- Branding - Available Assets -->
    <BitmapImage x:Key="CdsLogoLight" UriSource="pack://application:,,,/../../images/branding/cdsLogo-1000.png"/>
    <BitmapImage x:Key="CdsLogoDark" UriSource="pack://application:,,,/../../images/branding/cdsLogo-dark-1000.png"/>
    
    <!-- Future branding assets - Add when available -->
    <!-- <BitmapImage x:Key="LogoLight" UriSource="pack://application:,,,/../../images/branding/logo-light.png"/> -->
    <!-- <BitmapImage x:Key="LogoDark" UriSource="pack://application:,,,/../../images/branding/logo-dark.png"/> -->
    
    <!-- Image Styles for consistent sizing -->
    <Style x:Key="ToolbarImageStyle" TargetType="{x:Type Image}">
        <Setter Property="Width" Value="24"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="Stretch" Value="Uniform"/>
    </Style>
    
    <Style x:Key="MenuImageStyle" TargetType="{x:Type Image}">
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="16"/>
        <Setter Property="Stretch" Value="Uniform"/>
    </Style>
    
    <Style x:Key="DialogImageStyle" TargetType="{x:Type Image}">
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Stretch" Value="Uniform"/>
    </Style>

</ResourceDictionary>
