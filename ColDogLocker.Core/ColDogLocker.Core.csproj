<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <RootNamespace>ColDogStudios.ColDogLocker.Core</RootNamespace>
    </PropertyGroup>

    <!-- Include the generated file unconditionally at the top level -->
    <ItemGroup>
        <Compile Include="$(IntermediateOutputPath)AppInfo.g.cs">
            <AutoGen>true</AutoGen>
            <DesignTime>true</DesignTime>
            <DependentUpon>AppInfo.g.cs</DependentUpon>
        </Compile>
    </ItemGroup>

    <!-- Auto-generate AppInfo.g.cs at build time -->
    <Target Name="GenerateAppInfo" BeforeTargets="CoreCompile">
        <PropertyGroup>
            <BuildNumber Condition="'$(SourceRevisionId)' != ''">$(SourceRevisionId)</BuildNumber>
            <BuildNumber Condition="'$(BuildNumber)' == ''">source</BuildNumber>
            <BuildDate>Not recorded</BuildDate>
            <BuildTime>Not recorded</BuildTime>
            <BuildVersionFull>$(Version)+$(BuildNumber)</BuildVersionFull>
            <AppInfoContent>
                // &lt;auto-generated&gt;
                // This file is automatically generated at build time.
                // Do not edit manually - changes will be overwritten.
                // &lt;/auto-generated&gt;

                namespace ColDogStudios.ColDogLocker.Core.Environment%3B

                /// &lt;summary&gt;
                /// Build information auto-generated at compile time.
                /// &lt;/summary&gt;
                public static class AppInfo
                {
                /// &lt;summary&gt;
                /// Semantic version
                /// 1.0.0, 1.0.0-rc.1, 1.0.0-beta, 1.0.0-alpha
                /// &lt;/summary&gt;
                public const string SemanticVersion = "$(Version)"%3B

                /// &lt;summary&gt;Full semantic version with build metadata (e.g., "0.1.0-pre+202512301445")&lt;/summary&gt;
                public const string BuildVersion = "$(BuildVersionFull)"%3B

                /// &lt;summary&gt;Source revision when available. No wall-clock metadata is embedded.&lt;/summary&gt;
                public const string BuildNumber = "$(BuildNumber)"%3B

                /// &lt;summary&gt;Build date is deliberately omitted for reproducibility&lt;/summary&gt;
                public const string BuildDate = "$(BuildDate)"%3B

                /// &lt;summary&gt;Build time is deliberately omitted for reproducibility&lt;/summary&gt;
                public const string BuildTime = "$(BuildTime)"%3B
                }
            </AppInfoContent>
        </PropertyGroup>
        <WriteLinesToFile
            File="$(IntermediateOutputPath)AppInfo.g.cs"
            Lines="$(AppInfoContent)"
            Overwrite="true"
            Encoding="UTF-8"/>
        <!-- FileWrites can stay here — it's fine inside a Target -->
        <ItemGroup>
            <FileWrites Include="$(IntermediateOutputPath)AppInfo.g.cs"/>
        </ItemGroup>
    </Target>

</Project>
